# Copie ce fichier en ".env" (même dossier) et remplis-le.
# Ce fichier ne contient AUCUNE clé privée : la signature est faite par la CLI asentum.

# owner = toi ; collab = le collaborateur (chacun lance SON croupier avec SA chaîne)
ROLE=owner

# Adresse du contrat du loto (ase1… ou 0x…), donnée au déploiement
CONTRACT=ase1...

# Nom du compte CLI qui paie le gas des appels du croupier (asentum account list).
# Conseil : un compte dédié avec quelques ASE seulement (aucun droit admin n'est nécessaire).
ACCOUNT=croupier

# Nœud RPC (celui de ta config CLI)
RPC_URL=https://testnet.asentum.com

# Alertes Telegram : crée un bot avec @BotFather (token) et récupère ton chat id
# (envoie un message à ton bot puis ouvre https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel
# CROUPIER_NAME=croupier-owner-pc
# DATA_DIR=./data            # dossier de la chaîne de secrets (à sauvegarder !)
# TICK_MS=30000              # vérification toutes les 30 s
# HEALTH_PORT=8080           # pour Fly.io
# ASENTUM_BIN=/home/bastos/.asentum/bin/asentum   # chemin complet de la CLI (sur ton PC)
